worker_processes auto;
events { worker_connections 1024; }
http {
    sendfile on;
    client_max_body_size 64M; # Support large session recording uploads

    # Variables in proxy_pass make nginx refresh upstream addresses at this interval.
    resolver 8.8.8.8 8.8.4.4 valid=30s ipv6=off;
    resolver_timeout 5s;

    proxy_ssl_verify on;
    # The default depth of 1 rejects upstream chains that reach the trust anchor through a cross-signed root.
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

    # Forward PostHog keys (Bearer phc_, phs_ or phx_), which the SDKs need. Strip any other credentials.
    # To allow an older key without one of these prefixes, also match its exact "Bearer <key>" value.
    map $http_authorization $posthog_authorization {
        "~^Bearer ph[csx]_" $http_authorization;
        default     "";
    }

    server {
        listen ${PORT};
        server_name ${SERVER_NAME};
        
        # Health check endpoint
        location = /health {
            add_header 'Access-Control-Allow-Origin' '*' always;
            add_header 'Content-Type' 'text/plain' always;
            return 200 'OK';
        }
        
        # Static assets - from us-assets.i.posthog.com
        location /static {
            set $ph_assets ${POSTHOG_CLOUD_REGION}-assets.i.posthog.com;
            proxy_pass https://$ph_assets;
            proxy_set_header Host $ph_assets;
            proxy_ssl_server_name on;
            proxy_ssl_name $ph_assets;
            
            # The proxy runs on the site's own domain, so the browser attaches that
            # site's cookies to every request. PostHog never needs them.
            proxy_set_header Cookie "";
            proxy_set_header Authorization "";
            
            # Remove upstream CORS headers to prevent duplicates
            proxy_hide_header 'Access-Control-Allow-Origin';
            proxy_hide_header 'Access-Control-Allow-Methods';
            proxy_hide_header 'Access-Control-Allow-Headers';
            proxy_hide_header 'Access-Control-Expose-Headers';
            
            # Add CORS headers
            add_header 'Access-Control-Allow-Origin' '*' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range' always;
            add_header 'Access-Control-Expose-Headers' 'Content-Length,Content-Range' always;
        }
        
        # Main API endpoints
        location / {
            set $ph_ingest ${POSTHOG_CLOUD_REGION}.i.posthog.com;
            proxy_pass https://$ph_ingest;
            proxy_set_header Host $ph_ingest;
            proxy_ssl_server_name on;
            proxy_ssl_name $ph_ingest;
            
            # The proxy runs on the site's own domain, so the browser attaches that
            # site's cookies to every request. PostHog never needs them.
            proxy_set_header Cookie "";
            # nginx omits the header when the mapped value is empty.
            proxy_set_header Authorization $posthog_authorization;
            
            # Remove upstream CORS headers to prevent duplicates
            proxy_hide_header 'Access-Control-Allow-Origin';
            proxy_hide_header 'Access-Control-Allow-Methods';
            proxy_hide_header 'Access-Control-Allow-Headers';
            proxy_hide_header 'Access-Control-Expose-Headers';
            
            # Add CORS headers
            add_header 'Access-Control-Allow-Origin' '*' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range' always;
            add_header 'Access-Control-Expose-Headers' 'Content-Length,Content-Range' always;
        }
    }
}
